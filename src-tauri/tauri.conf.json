{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gino",
  "version": "0.1.0",
  "identifier": "app.ginos",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Gino",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../fixtures/fonts/CrimsonText-Regular.ttf": "fonts/CrimsonText-Regular.ttf",
      "../fixtures/fonts/GowunDodum-Regular.ttf": "fonts/GowunDodum-Regular.ttf",
      "../fixtures/fonts/README.md": "fonts/README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
